DJANGO_SECRET_KEY=replace-with-a-long-random-production-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=example.com,www.example.com,backend
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com
DB_ENGINE=django.db.backends.mysql
DB_NAME=collab_questions
DB_USER=collab_user
DB_PASSWORD=replace-with-a-strong-database-password
DB_HOST=db
DB_PORT=3306
MYSQL_DATABASE=collab_questions
MYSQL_USER=collab_user
MYSQL_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password

# Django production security
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true

# Start with one hour, then increase after HTTPS has been validated.
# Enable HSTS only after HTTPS has been validated in production.
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false

# Requests pass through Caddy and Docker Nginx before reaching Django.
DJANGO_NUM_PROXIES=2